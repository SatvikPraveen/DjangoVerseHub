# File: DjangoVerseHub/.env.example
# Copy to .env and adjust. Values here are safe defaults for local development.

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=django_verse_hub.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=
SITE_NAME=DjangoVerseHub
SITE_TAGLINE=Connect, Learn, Build
SITE_URL=http://localhost:8000
APP_VERSION=1.1.0

# --- Database (PostgreSQL) ----------------------------------------------
DB_NAME=djangoversehub
DB_USER=django_user
DB_PASSWORD=django_password
DB_HOST=localhost
DB_PORT=5432

# --- Redis: cache (db 1), channel layer (db 0), Celery (db 2/3) ---------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3
# Run Celery tasks inline without a worker (handy without Redis)
CELERY_TASK_ALWAYS_EAGER=False

# --- Email ---------------------------------------------------------------
# dev.py uses the console backend; these apply to production
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@djangoversehub.com
# allauth: mandatory | optional | none
ACCOUNT_EMAIL_VERIFICATION=mandatory

# --- Auth tokens ---------------------------------------------------------
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# --- Rate limiting and logging -----------------------------------------
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_MINUTE=100
SLOW_REQUEST_THRESHOLD_MS=1000
LOG_LEVEL=INFO
# verbose | json
LOG_FORMAT=verbose
# Production log directory (prod.py)
LOG_DIR=/var/log/djangoversehub

# --- Production security (prod.py) --------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
CORS_ALLOWED_ORIGINS=
ADMIN_URL=admin/

# --- Media storage on S3 (prod.py, optional) ----------------------------
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# --- Social login (django-allauth, optional) ----------------------------
GOOGLE_OAUTH2_KEY=
GOOGLE_OAUTH2_SECRET=
GITHUB_KEY=
GITHUB_SECRET=

# --- Monitoring (prod.py, optional) -------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

# --- Tests ---------------------------------------------------------------
# Set to 1 to run the real migration graph under the test settings
KEEP_MIGRATIONS=0
